# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
POSTGRES_DB=houston_311_db

# Read-only Database User (for application)
DB_HOST=postgres
DB_PORT=5432
DB_USER=readonly_311
DB_PASSWORD=CHANGE_ME_READONLY_PASSWORD_HERE
DB_NAME=houston_311_db

# LLM Configuration
LLM_MODEL=mistral
OLLAMA_HOST=http://YOUR_OLLAMA_SERVER:11434

# CORS Configuration (comma-separated list of allowed origins)
# For production, set this to your domain(s)
# Example: https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=*

# Application URLs
# For production, set this to your actual domain
FRONTEND_URL=http://localhost:4173
BACKEND_URL=http://localhost:8000

# Environment
ENVIRONMENT=development
# Set to 'production' when deploying
